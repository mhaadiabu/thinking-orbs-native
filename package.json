{
  "name": "@mhaadi/thinking-orbs-native",
  "version": "0.1.2",
  "description": "High-performance React Native thinking orb indicators.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mhaadiabu/thinking-orbs-native.git"
  },
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=20.6.0"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "react-native": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "source": "src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "docs/imagining-motion.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "pnpm build && node --import ./tests/register-engine-loader.mjs --test tests/*.test.mjs",
    "build": "pnpm clean && tsrs -p tsconfig.json",
    "typecheck": "tsrs --noEmit -p tsconfig.json",
    "lint": "tsrs --noEmit -p tsconfig.json",
    "clean": "node ./scripts/clean.mjs",
    "pack:check": "pnpm build && pnpm exec publint && pnpm pack --dry-run",
    "prepublishOnly": "pnpm pack:check",
    "release:check": "pnpm pack:check"
  },
  "peerDependencies": {
    "@shopify/react-native-skia": ">=2.0.0",
    "react": ">=18.2.0",
    "react-native": ">=0.73.0",
    "react-native-reanimated": ">=3.0.0"
  },
  "devDependencies": {
    "@shopify/react-native-skia": "^2.11.0",
    "@types/react": "^19.2.18",
    "publint": "^0.3.23",
    "react": "^19.2.8",
    "react-native": "^0.86.2",
    "react-native-reanimated": "^4.5.3",
    "react-native-worklets": "^0.11.3",
    "turbo": "^2.10.9",
    "tsrs": "7.1.0-beta.tsrs5"
  }
}
