  .landing-page *{min-width:0}
  .landing-page img, .landing-page canvas, .landing-page svg{max-width:100%;height:auto}
  .landing-page img, .landing-page canvas{display:block}
  :global(html:not([data-mode="dark"])) .landing-page{--page:#f7f7f5;--panel:#fff;--panel-2:#efefec;--ink:#171717;--muted:#74746e;--line:#d9d9d4}
