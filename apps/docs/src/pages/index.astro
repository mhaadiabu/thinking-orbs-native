  .hero{min-height:680px;display:grid;grid-template-columns:1fr .88fr;gap:72px;align-items:center;padding-block:80px;min-width:0}.hero-copy{min-width:0;overflow-wrap:anywhere}.kicker{display:flex;align-items:center;gap:10px;margin:0 0 22px;color:var(--muted);font-size:10px;text-transform:uppercase;letter-spacing:.14em}.kicker span{display:block;width:4px;height:4px;background:var(--ink)}
  h1,h2{margin:0;color:var(--ink);font-family:var(--nb-font-mono);font-weight:500;letter-spacing:-.07em;line-height:.94;overflow-wrap:anywhere}h1{font-size:clamp(38px,10vw,86px)}h2{font-size:clamp(32px,5vw,68px)}h1 em,h2 em{color:var(--muted);font:inherit;font-weight:300}.hero-lede{max-width:610px;margin:30px 0;color:var(--muted);font-size:13px;line-height:1.8;overflow-wrap:anywhere}.hero-actions{display:flex;gap:10px;flex-wrap:wrap}.button{display:inline-flex;align-items:center;gap:8px;padding:12px 16px;border:1px solid var(--line);font-size:11px;text-decoration:none;transition:.2s;white-space:nowrap}.button svg,.install-copy>a svg,.text-link svg{width:13px;height:13px}.button-primary{background:var(--ink);border-color:var(--ink);color:var(--page)}.button-primary:hover{background:var(--muted);border-color:var(--muted)}.button-secondary{color:var(--muted)}.button-secondary:hover{border-color:var(--ink);color:var(--ink)}
  .hero-stage{position:relative;min-height:486px;min-width:0;border:1px solid var(--line);background:var(--panel);display:grid;place-items:center;overflow:hidden;box-sizing:border-box}.stage-grid{position:absolute;inset:0;background-image:linear-gradient(var(--line) 1px,transparent 1px),linear-gradient(90deg,var(--line) 1px,transparent 1px);background-size:48px 48px;mask-image:linear-gradient(to bottom,transparent,black 18%,black 82%,transparent);-webkit-mask-image:linear-gradient(to bottom,transparent,black 18%,black 82%,transparent);opacity:.5}.hero-pill{position:relative;display:flex;align-items:center;gap:17px;width:304px;width:min(304px,calc(100% - 24px));max-width:100%;height:88px;padding:3px 16px 3px 7px;border:1px solid var(--line);border:1px solid color-mix(in srgb,var(--ink) 12%,transparent);border-radius:999px;background:var(--panel);background:color-mix(in srgb,var(--ink) 5%,var(--panel));box-shadow:none;box-shadow:inset 0 0 50px color-mix(in srgb,var(--ink) 2%,transparent);font-size:clamp(14px,4vw,18px);box-sizing:border-box;overflow:hidden;-webkit-overflow-scrolling:touch}.stage-readout{position:absolute;left:12px;right:12px;bottom:12px;display:flex;justify-content:space-between;gap:8px;flex-wrap:wrap;color:var(--muted);font-size:9px;text-transform:uppercase;letter-spacing:.08em}.stage-readout span:first-child{color:var(--ink)}.stage-readout i{display:inline-block;width:4px;height:4px;margin-right:5px;background:var(--ink);animation:pulse 1.5s infinite}
  .shimmer{position:relative;color:var(--muted);color:color-mix(in srgb,var(--ink) 45%,transparent)}.shimmer::before{content:attr(data-text);position:absolute;inset:0;background:linear-gradient(90deg,transparent 35%,var(--ink) 50%,transparent 65%);background-size:400% 100%;background-clip:text;-webkit-background-clip:text;color:transparent;animation:shimmer 2.2s linear infinite}
