---
import SiteLayout from "../layouts/SiteLayout.astro";
import OrbCanvas from "../components/OrbCanvas.astro";
import { Icon } from "astro-icon/components";
import type { OrbState } from "../../../../src/types";

const states: Array<{ state: OrbState; label: string; note: string }> = [
  { state: "working", label: "Working…", note: "general work in flight" },
  { state: "searching", label: "Searching…", note: "looking something up" },
  { state: "solving", label: "Solving…", note: "working through a problem" },
  { state: "listening", label: "Listening…", note: "receiving input" },
  { state: "connecting", label: "Connecting…", note: "opening a connection" },
  { state: "weaving", label: "Weaving…", note: "combining ideas" },
  { state: "composing", label: "Composing…", note: "writing a response" },
  { state: "breathing", label: "Thinking…", note: "quiet neutral thought" },
  { state: "shaping", label: "Shaping…", note: "forming a structure" },
];

const installCommand = "pnpm add @mhaadi/thinking-orbs-native @shopify/react-native-skia react-native-reanimated react-native-worklets";
const usageSnippet = `import { ThinkingOrb } from '@mhaadi/thinking-orbs-native';

<ThinkingOrb state="searching" size={64} />`;
---

<SiteLayout
  title="Thinking Orbs · React Native"
  description="Nine animated thinking states, rendered natively with Skia and Reanimated."
>
  <div class="landing-page">


    <main id="main-content">
      <section class="hero shell">
        <div class="hero-copy">
          <p class="kicker"><span></span> React Native / Skia / Reanimated</p>
          <h1>Thinking states<br />that feel <em>native.</em></h1>
          <p class="hero-lede">
            Nine animated indicators for the moments between a request and a result.
            Faithful to the open-source Thinking Orbs family, rebuilt for the native UI thread.
          </p>
          <div class="hero-actions">
            <a class="button button-primary" href="#install">install package</a>
            <a class="button button-secondary" href="#states">view states <Icon name="ph:arrow-down" /></a>
          </div>
        </div>

        <div class="hero-stage" aria-label="Animated composing state preview">
          <div class="stage-grid" aria-hidden="true"></div>
          <div class="hero-pill">
            <OrbCanvas state="composing" size={64} displaySize={82} />
            <span class="shimmer" data-text="Thinking…">Thinking…</span>
          </div>
          <div class="stage-readout">
            <span><i></i> live</span>
            <span>state / composing</span>
            <span>64px</span>
          </div>
        </div>
      </section>

      <section id="states" class="states-section shell">
        <div class="section-heading">
          <div>
            <p class="kicker"><span></span> the full vocabulary</p>
            <h2>Nine states.<br /><em>One visual language.</em></h2>
          </div>
          <p>Use motion as information. Each preset describes a different kind of work without adding another status message.</p>
        </div>

        <div class="state-grid">
          {states.map(({ state, label, note }, index) => (
            <article class="state-card" data-state={state}>
              <div class="state-index">{String(index + 1).padStart(2, "0")}</div>
              <div class="state-preview">
                <div class="message-pill">
                  <OrbCanvas state={state} size={64} displaySize={56} />
                  <span class="shimmer" data-text={label}>{label}</span>
                </div>
              </div>
              <div class="state-meta">
                <h3>{state}</h3>
                <p>{note}</p>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section id="install" class="install-section">
        <div class="shell install-grid">
          <div class="install-copy">
            <p class="kicker"><span></span> package / v0.1</p>
            <h2>Drop it into<br /><em>the in-between.</em></h2>
            <p>
              The public API stays small. Choose a state and density profile; theme,
              pausing, reduced motion, and accessibility are already accounted for.
            </p>
            <a href="https://www.npmjs.com/package/@mhaadi/thinking-orbs-native" target="_blank" rel="noopener">package details <Icon name="ph:arrow-up-right" /></a>
          </div>

          <div class="code-stack">
            <div class="code-block">
              <div class="code-label"><span>01</span> install package <button data-copy={installCommand}>copy</button></div>
              <pre><code>{installCommand}</code></pre>
            </div>
            <div class="code-block">
              <div class="code-label"><span>02</span> render a state <button data-copy={usageSnippet}>copy</button></div>
              <pre><code>{usageSnippet}</code></pre>
            </div>
          </div>
        </div>
      </section>

      <section class="playground-section shell" aria-label="Interactive playground">
        <div class="playground-head">
          <div>
            <p class="kicker"><span></span> live specimen</p>
            <h2>Playground</h2>
          </div>
          <p>Same presets. Same engine. Select a state and inspect it at native density.</p>
        </div>

        <div class="playground" data-playground>
          <div class="controls">
            <div class="control-group">
              <span class="control-label" id="state-label">state</span>
              <div class="state-tabs" role="radiogroup" aria-labelledby="state-label">
                {states.map(({ state }) => <button type="button" role="radio" aria-checked={state === "listening" ? "true" : "false"} tabindex={state === "listening" ? 0 : -1} class:list={[state === "listening" && "active"]} data-state-option={state}>{state}</button>)}
              </div>
            </div>
            <div class="control-row">
              <div class="control-group">
                <span class="control-label" id="size-label">size</span>
                <div class="size-tabs" role="radiogroup" aria-labelledby="size-label">
                  <button type="button" role="radio" aria-checked="true" tabindex="0" class="active" data-size-option="64">64px</button>
                  <button type="button" role="radio" aria-checked="false" tabindex="-1" data-size-option="20">20px</button>
                </div>
              </div>
              <div class="control-group">
                <span class="control-label">speed</span>
                <div class="speed-tabs">
                  <button data-speed-option="0.5">0.5×</button>
                  <button class="active" data-speed-option="1">1×</button>
                  <button data-speed-option="1.25">1.25×</button>
                  <button data-speed-option="1.5">1.5×</button>
                </div>
              </div>
              <button class="pause-button" data-pause aria-pressed="false">
                <Icon name="ph:pause" data-pause-icon />
                <Icon name="ph:play" data-play-icon />
                <span data-pause-label>pause</span>
              </button>
            </div>
          </div>
          <div class="playground-preview">
            <div class="preview-crosshair" aria-hidden="true"></div>
            <OrbCanvas state="listening" size={64} displaySize={128} class="playground-orb" />
            <p data-preview-label>listening / 64</p>
          </div>
          <div class="playground-code">
            <span>tsx</span>
            <code data-snippet>&lt;ThinkingOrb state="listening" size=&#123;64&#125; /&gt;</code>
          </div>
        </div>
      </section>

    </main>

    <footer class="site-footer shell">
      <a class="brand" href="/"><span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i><i></i></span><span>thinking-orbs-native</span></a>
      <div class="footer-credit">
        <p>Made by <a class="credit-link" href="https://x.com/mhaadiabu" target="_blank" rel="noopener"><svg viewBox="0 0 100 100" aria-hidden="true"><path fill="currentColor" d="M59.31 42.344 95.736 0h-8.633L55.475 36.766 30.213 0H1.075l38.202 55.597L1.075 100h8.633L43.11 61.174 69.788 100h29.137L59.307 42.344zM47.486 56.086l-3.87-5.536L12.817 6.498h13.26L50.93 42.05l3.87 5.536 32.307 46.21H73.85L47.486 56.089z"/></svg>mhaadiabu</a></p>
        <p class="credit-note">A React Native port of <a class="text-link" href="https://orbs.jakubantalik.com" target="_blank" rel="noopener">Thinking Orbs <Icon name="ph:arrow-up-right" /></a> by
          <a class="credit-link" href="https://x.com/jakubantalik" target="_blank" rel="noopener"><svg viewBox="0 0 100 100" aria-hidden="true"><path fill="currentColor" d="M59.31 42.344 95.736 0h-8.633L55.475 36.766 30.213 0H1.075l38.202 55.597L1.075 100h8.633L43.11 61.174 69.788 100h29.137L59.307 42.344zM47.486 56.086l-3.87-5.536L12.817 6.498h13.26L50.93 42.05l3.87 5.536 32.307 46.21H73.85L47.486 56.089z"/></svg>@jakubantalik</a>
          <span aria-hidden="true">and</span>
          <a class="credit-link" href="https://x.com/a_brinza" target="_blank" rel="noopener"><svg viewBox="0 0 100 100" aria-hidden="true"><path fill="currentColor" d="M59.31 42.344 95.736 0h-8.633L55.475 36.766 30.213 0H1.075l38.202 55.597L1.075 100h8.633L43.11 61.174 69.788 100h29.137L59.307 42.344zM47.486 56.086l-3.87-5.536L12.817 6.498h13.26L50.93 42.05l3.87 5.536 32.307 46.21H73.85L47.486 56.089z"/></svg>@a_brinza</a>
        </p>
      </div>
      <div class="footer-links">
        <a href="/changelog">changelog</a>
        <a class="brand-icon npm-icon" href="https://www.npmjs.com/package/@mhaadi/thinking-orbs-native" target="_blank" rel="noopener" aria-label="View package on npm">
          <svg viewBox="0 0 100 100" aria-hidden="true"><path fill="#c00" d="M0 0h100v100H0z"/><path fill="#fff" d="M49.66 10.74H10.74v78.516h38.916V30.54h19.8v58.716h19.8V10.74z"/></svg>
        </a>
        <a class="brand-icon" href="https://github.com/mhaadiabu/thinking-orbs-native" target="_blank" rel="noopener" aria-label="View source on GitHub">
          <svg viewBox="0 0 100 100" aria-hidden="true"><path fill="currentColor" d="M50 1C22.39 1 0 23.386 0 51c0 22.092 14.327 40.834 34.193 47.446 2.499.462 3.417-1.085 3.417-2.406 0-1.192-.047-5.131-.068-9.309-13.91 3.025-16.846-5.9-16.846-5.9-2.274-5.779-5.551-7.315-5.551-7.315-4.537-3.104.341-3.04.341-3.04 5.022.353 7.665 5.153 7.665 5.153 4.46 7.644 11.697 5.434 14.55 4.156.449-3.232 1.745-5.437 3.175-6.686-11.106-1.264-22.78-5.552-22.78-24.71 0-5.459 1.953-9.92 5.151-13.42-.519-1.26-2.23-6.346.485-13.233 0 0 4.198-1.344 13.753 5.125 3.988-1.108 8.266-1.663 12.515-1.682 4.25.019 8.53.574 12.526 1.682 9.544-6.469 13.736-5.125 13.736-5.125 2.722 6.887 1.01 11.973.49 13.232 3.206 3.502 5.146 7.962 5.146 13.42 0 19.205-11.697 23.434-22.83 24.671 1.793 1.552 3.391 4.595 3.391 9.26 0 6.69-.058 12.074-.058 13.721 0 1.33.9 2.89 3.435 2.399C85.692 91.819 100 73.085 100 51 100 23.386 77.614 1 50 1Z"/></svg>
        </a>
      </div>
    </footer>
  </div>

  <script>
    import { mount } from "@cloudflare/nimbus-docs/client";

    mount(".landing-page", () => {
      const listeners = new AbortController();
      const copyButtons = document.querySelectorAll<HTMLButtonElement>("[data-copy]");
      copyButtons.forEach((button) => {
        button.addEventListener("click", async () => {
          try {
            if (!navigator.clipboard) throw new Error("Clipboard unavailable");
            await navigator.clipboard.writeText(button.dataset.copy ?? "");
            button.textContent = "copied";
          } catch {
            button.textContent = "copy failed";
          }
          window.setTimeout(() => { button.textContent = "copy"; }, 1200);
        }, { signal: listeners.signal });
      });

      const playground = document.querySelector<HTMLElement>("[data-playground]");
      if (playground) {
        const canvas = playground.querySelector<HTMLCanvasElement>("[data-orb-canvas]");
        const label = playground.querySelector<HTMLElement>("[data-preview-label]");
        const snippet = playground.querySelector<HTMLElement>("[data-snippet]");
        const pause = playground.querySelector<HTMLButtonElement>("[data-pause]");
        const pauseLabel = pause?.querySelector<HTMLElement>("[data-pause-label]");
        let state = "listening";
        let size = 64;
        let speed = 1;
        let paused = false;

        const update = () => {
          if (canvas) {
            canvas.dataset.state = state;
            canvas.dataset.orbSize = String(size);
            canvas.dataset.displaySize = size === 64 ? "128" : "60";
            canvas.dataset.speed = String(speed);
            canvas.setAttribute("aria-label", `${state} thinking indicator`);
          }
          if (label) label.textContent = `${state} / ${size}`;
          if (snippet) snippet.textContent = `<ThinkingOrb state="${state}" size={${size}} speed={${speed}} />`;
        };

        playground.querySelectorAll<HTMLButtonElement>("[data-state-option]").forEach((button) => {
          button.addEventListener("click", () => {
            state = button.dataset.stateOption ?? state;
            playground.querySelectorAll<HTMLElement>("[data-state-option]").forEach((item) => { item.classList.remove("active"); item.setAttribute("aria-checked", "false"); item.tabIndex = -1; });
            button.classList.add("active");
            button.setAttribute("aria-checked", "true"); button.tabIndex = 0;
            update();
          });
        });

        playground.querySelectorAll<HTMLButtonElement>("[data-size-option]").forEach((button) => {
          button.addEventListener("click", () => {
            size = Number(button.dataset.sizeOption ?? size);
            playground.querySelectorAll<HTMLElement>("[data-size-option]").forEach((item) => { item.classList.remove("active"); item.setAttribute("aria-checked", "false"); item.tabIndex = -1; });
            button.classList.add("active");
            button.setAttribute("aria-checked", "true"); button.tabIndex = 0;
            update();
          });
        });

        playground.querySelectorAll<HTMLButtonElement>("[data-speed-option]").forEach((button) => {
          button.addEventListener("click", () => {
            speed = Number(button.dataset.speedOption ?? speed);
            playground.querySelectorAll("[data-speed-option]").forEach((item) => item.classList.remove("active"));
            button.classList.add("active");
            update();
          });
        });

        const setupRadioKeys = (selector: string) => {
          const options = Array.from(playground.querySelectorAll<HTMLButtonElement>(selector));
          options.forEach((button, index) => button.addEventListener("keydown", (event) => {
            if (!["ArrowRight", "ArrowDown", "ArrowLeft", "ArrowUp"].includes(event.key)) return;
            event.preventDefault();
            const direction = event.key === "ArrowRight" || event.key === "ArrowDown" ? 1 : -1;
            options[(index + direction + options.length) % options.length]?.focus();
          }, { signal: listeners.signal }));
        };
        setupRadioKeys("[data-state-option]");
        setupRadioKeys("[data-size-option]");

        pause?.addEventListener("click", () => {
          paused = !paused;
          if (canvas) canvas.dataset.paused = String(paused);
          pause.classList.toggle("active", paused);
          pause.setAttribute("aria-pressed", String(paused));
          if (pauseLabel) pauseLabel.textContent = paused ? "play" : "pause";
        }, { signal: listeners.signal });
      }
      return () => listeners.abort();
    });
  </script>
</SiteLayout>

<style>
